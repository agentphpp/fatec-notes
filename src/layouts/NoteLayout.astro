---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { ArrowLeft } from 'lucide-astro';

interface Props {
  title: string;
  subjectName: string;
  subjectSlug: string;
  dateLabel?: string;
  headings: MarkdownHeading[];
}
const { title, subjectName, subjectSlug, dateLabel, headings } = Astro.props;
---

<BaseLayout title={title}>
  <ReadingProgress />

  <a
    href={`/materias/${subjectSlug}`}
    class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
  >
    <ArrowLeft class="h-4 w-4" /> Voltar para {subjectName}
  </a>

  <div class="lg:grid lg:grid-cols-[1fr_220px] lg:gap-10">
    <article>
      <header class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 sm:text-3xl">{title}</h1>
        {dateLabel && <p class="mt-1 text-sm text-slate-400 dark:text-slate-500">{dateLabel}</p>}
      </header>

      <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-pre:bg-slate-900">
        <slot />
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>
