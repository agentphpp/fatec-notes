---
import { NotebookText } from 'lucide-astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-slate-50/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-semibold text-slate-800 dark:text-slate-100">
      <NotebookText class="h-5 w-5 text-brand-600 dark:text-brand-400" />
      <span>Anotações DSM · FATEC Jaú</span>
    </a>
    <ThemeToggle />
  </div>
</header>
