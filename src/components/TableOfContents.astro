---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
// só mostramos H2 e H3 pra não poluir o índice
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filtered.length > 0 && (
  <nav aria-label="Índice do resumo" class="text-sm">
    <p class="mb-2 font-semibold uppercase tracking-wide text-xs text-slate-400 dark:text-slate-500">
      Nesta aula
    </p>
    <ul class="space-y-1.5 border-l border-slate-200 dark:border-slate-800">
      {filtered.map((h) => (
        <li class={h.depth === 3 ? 'pl-6' : 'pl-3'}>
          <a
            href={`#${h.slug}`}
            class="block truncate text-slate-500 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
